{
  "name": "@sandeshthapa07/nepal-utils",
  "version": "0.1.0",
  "description": "Nepal utilities: NPR formatting with lakh/crore grouping, amounts in words (English and Nepali), Devanagari digits, and validators for Nepali mobile, landline, PAN and postal codes.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./numerals": {
      "import": {
        "types": "./dist/numerals/index.d.ts",
        "default": "./dist/numerals/index.js"
      },
      "require": {
        "types": "./dist/numerals/index.d.cts",
        "default": "./dist/numerals/index.cjs"
      }
    },
    "./currency": {
      "import": {
        "types": "./dist/currency/index.d.ts",
        "default": "./dist/currency/index.js"
      },
      "require": {
        "types": "./dist/currency/index.d.cts",
        "default": "./dist/currency/index.cjs"
      }
    },
    "./validators": {
      "import": {
        "types": "./dist/validators/index.d.ts",
        "default": "./dist/validators/index.js"
      },
      "require": {
        "types": "./dist/validators/index.d.cts",
        "default": "./dist/validators/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "nepal",
    "nepali",
    "npr",
    "rupee",
    "currency",
    "lakh",
    "crore",
    "number-to-words",
    "devanagari",
    "validator",
    "phone",
    "pan"
  ],
  "license": "MIT",
  "author": "Sandesh Thapa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandeshthapa07/nepal-utils.git"
  },
  "homepage": "https://github.com/sandeshthapa07/nepal-utils#readme",
  "bugs": {
    "url": "https://github.com/sandeshthapa07/nepal-utils/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
